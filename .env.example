# ---------------------------------------------------------------------------
# DocuTrust - example environment configuration
#
# Copy to `.env` and fill in real values:      cp .env.example .env
#
# `.env` is gitignored. NEVER commit real secrets, passwords or key material.
# Every value below is a non-secret placeholder safe to keep in version control.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
POSTGRES_DB=docutrust
POSTGRES_USER=docutrust
# Replace before running. Generate one, e.g. openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_local_dev_only
POSTGRES_PORT=5432

# --- Object storage (MinIO) ------------------------------------------------
MINIO_ROOT_USER=docutrust
# Replace before running. Minimum 8 characters enforced by MinIO.
MINIO_ROOT_PASSWORD=CHANGE_ME_local_dev_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=docutrust-documents

# --- Backend ---------------------------------------------------------------
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT signing secret. MUST be >= 32 bytes of high-entropy material.
# Generate one:  openssl rand -base64 48
# The application refuses to start in a non-dev profile if this is unset or weak.
DOCUTRUST_JWT_SECRET=CHANGE_ME_generate_at_least_32_bytes_of_random_data
DOCUTRUST_JWT_TTL_MINUTES=60

# --- Demo / development users ---------------------------------------------
# Section 5.1 of the spec: demo credentials come from the environment,
# never from source code. Seeded ONLY under the `dev` profile.
DOCUTRUST_DEMO_USER_EMAIL=demo@docutrust.local
DOCUTRUST_DEMO_USER_PASSWORD=CHANGE_ME_local_dev_only
DOCUTRUST_DEMO_ADMIN_EMAIL=admin@docutrust.local
DOCUTRUST_DEMO_ADMIN_PASSWORD=CHANGE_ME_local_dev_only

# --- Development signing PKI ----------------------------------------------
# Generated locally by `make generate-dev-cert`. Path is gitignored.
DOCUTRUST_SIGNING_PROVIDER=pkcs12
DOCUTRUST_PKCS12_PATH=./pki-local/signer.p12
DOCUTRUST_PKCS12_PASSWORD=CHANGE_ME_local_dev_only
DOCUTRUST_PKCS12_ALIAS=docutrust-signer

# Trust anchors used to evaluate certificate chains during verification.
# Trust is explicit: certificates embedded in a PDF are NEVER trusted implicitly.
DOCUTRUST_TRUSTSTORE_PATH=./pki-local/truststore.p12
DOCUTRUST_TRUSTSTORE_PASSWORD=CHANGE_ME_local_dev_only

# --- Timestamping (RFC 3161) ----------------------------------------------
# Leave DISABLED unless a real TSA is reachable. When disabled, DocuTrust
# reports timestamp status as NOT_AVAILABLE. It never fabricates a timestamp.
DOCUTRUST_TSA_ENABLED=false
DOCUTRUST_TSA_URL=

# --- Revocation (OCSP / CRL) ----------------------------------------------
# When disabled, revocation status is reported as NOT_CHECKED - never as GOOD.
DOCUTRUST_REVOCATION_ENABLED=false
DOCUTRUST_REVOCATION_TIMEOUT_SECONDS=10

# --- Upload limits ---------------------------------------------------------
DOCUTRUST_MAX_UPLOAD_SIZE_MB=25

# --- Frontend --------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
