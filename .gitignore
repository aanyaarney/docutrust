# ---------------------------------------------------------------------------
# DocuTrust .gitignore
#
# SECURITY CRITICAL.
# This file is the last line of defence against committing private key
# material. Treat every addition here as a security change.
# ---------------------------------------------------------------------------

# --- Cryptographic key material: NEVER commit ------------------------------
*.p12
*.pfx
*.jks
*.keystore
*.key
*.pem
*.der
*.crt
*.cer
*.csr
*.srl
*.p8
*.pk8

# The generated development PKI lives here and must stay local.
/pki-local/
/backend/pki-local/
/backend/src/main/resources/pki-local/
**/trust/local/

# Exception: committed *sample* public trust anchors are explicitly opted in
# via `git add -f` only after review. Nothing is whitelisted by default.

# --- Secrets ---------------------------------------------------------------
.env
.env.*
!.env.example
*.secret
secrets/
application-local.yml
application-local.yaml
application-local.properties

# --- Java / Maven ----------------------------------------------------------
target/
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties
*.class
*.jar
!maven-wrapper.jar
*.war
*.ear
hs_err_pid*
replay_pid*
dependency-reduced-pom.xml

# --- Node / frontend -------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
.vite/
coverage/
*.local
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Local infrastructure state -------------------------------------------
# MinIO object data, Postgres volumes, Prometheus/Grafana state.
/.data/
/infrastructure/.data/
minio-data/
postgres-data/
grafana-data/
prometheus-data/

# --- Test / build output ---------------------------------------------------
/backend/attack-output/
/backend/test-output/
surefire-reports/
failsafe-reports/
*.log

# --- IDE / OS --------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
.settings/
.project
.classpath
.DS_Store
Thumbs.db
desktop.ini

# Derived / generated artefacts
/backend-source-code.md
/frontend-source-code.md
/report/*.pdf
/report/*.bak.html
